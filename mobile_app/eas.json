{
  "cli": {
    "version": ">= 18.5.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development"
    },
    "preview": {
      "autoIncrement": true,
      "distribution": "internal",
      "channel": "preview",
      "android": {
        "buildType": "apk"
      }
    },
    "joe": {
      "autoIncrement": true,
      "distribution": "internal",
      "channel": "joe",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_APP_VARIANT": "joe",
        "EXPO_PUBLIC_APP_OWNER_NAME": "Joe Lasala",
        "EXPO_PUBLIC_API_BASE": "https://joe-api.luxuryimportsusa.shop",
        "EXPO_PUBLIC_API_FALLBACKS": "__NONE__",
        "EXPO_PUBLIC_DISABLE_FONT_SCALING": "true",
        "EXPO_PUBLIC_UI_SCALE": "0.9",
        "EXPO_PUBLIC_LOCK_CONNECTION": "true",
        "EXPO_PUBLIC_RELEASE_LABEL": "joe-2026.05.28.1"
      }
    },
    "production": {
      "autoIncrement": true,
      "channel": "production"
    }
  },
  "submit": {
    "production": {}
  }
}
